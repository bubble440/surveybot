# Pour activer les snapshots (debug) :
New-Item -ItemType Directory -Force snapshots | Out-Null
Set-Content -Path snapshots\.snapshot_flag -Value "on"

# Pour désactiver les snapshots (debug) :
Remove-Item -Force snapshots\.snapshot_flag -ErrorAction SilentlyContinue

# Pour rejouer un snapshot et enregistrer une nouvelle baseline (debug) :
Set-Location C:\projects\Surveys\surveybot
python tools\replay_snapshot.py ..\snapshots\20260116_151932_after_dom_analyze --use-dom-outer --save-baseline
python tools\replay_snapshot.py ..\snapshots\20260116_151932_after_dom_analyze --use-dom-outer --headful --pause

